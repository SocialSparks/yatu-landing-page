# Copie ce fichier en .env.local (ignoré par git) et remplis les valeurs.

# Où les deux formulaires (waitlist + démo BDE) envoient leurs soumissions.
# URL /exec du déploiement Apps Script - voir scripts/google-sheet.gs.
# Laissé vide, les formulaires restent en mode local : rien n'est envoyé, la
# soumission est gardée dans localStorage et le parcours reste testable.
NEXT_PUBLIC_FORMS_ENDPOINT=

# Uniquement sur un hôte de préversion, pour que les URLs canoniques suivent la
# préversion au lieu de se déclarer comme la page de production.
# NEXT_PUBLIC_SITE_URL=
