# URL publique utilisée pour les canonical et les métadonnées.
NEXT_PUBLIC_SITE_URL=https://yatu-app.com

# Formulaires (laisser vide pour conserver uniquement le mode local).
NEXT_PUBLIC_FORMS_ENDPOINT=

# Mesure d’audience, chargée uniquement après consentement.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Contenu de la balise meta google-site-verification fournie par Search Console.
GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
