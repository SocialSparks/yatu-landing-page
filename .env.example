# URL publique utilisée pour les canonical et les métadonnées.
NEXT_PUBLIC_SITE_URL=https://yatu-app.com

# État du lancement : `auto` suit LAUNCH_DATE, `pre` force la waitlist et
# `post` force les boutons de téléchargement. Redémarrer `npm run dev` après
# chaque changement.
NEXT_PUBLIC_LAUNCH_MODE=auto

# Les formulaires n'ont plus de variable de build : l'URL Apps Script vit côté
# Worker (`npx wrangler secret put FORMS_ENDPOINT`) et, en local, dans
# `.dev.vars` - voir `.dev.vars.example`.

# Mesure d’audience, chargée uniquement après consentement.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Contenu de la balise meta google-site-verification fournie par Search Console.
GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
