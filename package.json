{
  "name": "yatu-landing-page",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "npm run generate:agents",
    "dev": "next dev",
    "prebuild": "npm run generate:agents",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "logs": "wrangler tail --format pretty",
    "logs:errors": "wrangler tail --status error --format pretty",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "generate:agents": "node scripts/generate-agent-content.mjs",
    "check:agents": "node scripts/check-agent-readiness.mjs"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "next": "^15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.35.3",
    "typescript": "5.9.2",
    "wrangler": "4.86.0"
  }
}
