{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "yatu-landing-page",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"upload_source_maps": true,
	// Le tampon des formulaires. Une soumission est rangee ici avant toute
	// tentative d'envoi vers Google Apps Script : c'est ce qui fait qu'une panne
	// du script, un bloqueur de pub ou son verrou de 20 s ne perdent plus rien.
	// `database_id` est renvoye par `npx wrangler d1 create yatu-forms`.
	"d1_databases": [
		{
			"binding": "FORMS_DB",
			"database_name": "yatu-forms",
			"database_id": "5b2b3b1a-6230-433f-9be8-a8be86f2cd0f",
			"migrations_dir": "migrations"
		}
	],
	// Le compteur est par centre de donnees Cloudflare et `period` n'accepte que
	// 10 ou 60 : de quoi arreter un script qui martele l'endpoint, pas un quota
	// global. `namespace_id` est un identifiant libre, propre a ce Worker.
	"ratelimits": [
		{
			"name": "FORMS_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	}
}